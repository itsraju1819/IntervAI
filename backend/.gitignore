# ========================================
# IntervAI Backend - Git Ignore Rules
# ========================================

# Secrets & Environment variables
.env
.env.*
*.env
!backend/.env.example
secrets.json
*.key
*.pem

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# Database files
*.db
*.sqlite3

# Test & Coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/

# Editor & OS files
.DS_Store
.vscode/
.idea/
