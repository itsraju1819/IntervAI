# ==============================================================================
# IntervAI - Environment Configuration Template
# Copy this file to "backend/.env" and set your environment variables.
# NEVER commit the real ".env" file to version control.
# ==============================================================================

# AI Service Credentials
# Get your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Active Gemini Model Identifier
GEMINI_MODEL=gemini-2.5-flash

# Environment Mode: development | production | test
ENVIRONMENT=development

# Allowed Origins for CORS (comma-separated, NO wildcards allowed when credentials=true)
FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500

# Rate Limiting Configuration
RATE_LIMIT_PER_MINUTE=60

# Max Questions per Session
MAX_QUESTIONS=5
