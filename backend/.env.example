# Copy this file to ".env" in the same folder and fill in your real key.
# Never commit the real ".env" file — it is already listed in .gitignore.

# Required: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: which Gemini model to call. gemini-3.5-flash is the current
# general-availability flash model (as of mid-2026) — good balance of
# quality/cost/speed for question generation and answer analysis.
GEMINI_MODEL=gemini-3.5-flash

# Optional: comma-separated list of origins allowed to call this backend
# from the browser. Defaults below work with `python -m http.server` or
# VS Code "Live Server" serving the IntervAI/ frontend folder.
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
